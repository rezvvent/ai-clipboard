DATABASE_URL=postgresql://aiclipboard:replace-me@postgres/aiclipboard
POSTGRES_PASSWORD=replace-me
JWT_SECRET=replace-with-at-least-32-random-bytes
SERVER_DATA_KEY=replace-with-base64-of-exactly-32-random-bytes
# Cloud alternative: a generated opaque secret of at least 32 bytes.
# Set only one of SERVER_DATA_KEY or SERVER_DATA_SECRET.
# SERVER_DATA_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=ai-clipboard-sync
JWT_AUDIENCE=ai-clipboard-clients
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
ALLOW_INSECURE_HTTP=false
ALLOWED_ORIGINS=https://clipboard.example.com
ENVIRONMENT=production
GEMINI_API_KEY=replace-with-google-ai-studio-api-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_TIMEOUT_SECONDS=120
